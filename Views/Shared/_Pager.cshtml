@model object
@{
    if (Model is not IPagedList p) { return; }

    var first = p.TotalCount == 0 ? 0 : (p.PageIndex - 1) * p.PageSize + 1;
    var last = Math.Min(p.PageIndex * p.PageSize, p.TotalCount);

    string Href(int n)
    {
        var kept = Context.Request.Query
            .Where(k => !string.Equals(k.Key, p.PageParam, StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value.Select(v => new KeyValuePair<string, string?>(k.Key, v)))
            .ToList();
        if (n > 1) kept.Add(new KeyValuePair<string, string?>(p.PageParam, n.ToString()));
        var path = Context.Request.PathBase.Add(Context.Request.Path).ToString();
        return path + QueryString.Create(kept).ToString() + (string.IsNullOrEmpty(p.Fragment) ? "" : "#" + p.Fragment);
    }

    var shown = new SortedSet<int> { 1, p.TotalPages };
    for (var i = p.PageIndex - 2; i <= p.PageIndex + 2; i++)
        if (i >= 1 && i <= p.TotalPages) shown.Add(i);
    var prev = 0;
}

@if (p.TotalCount > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <div class="text-muted small">Hiển thị @(first)–@(last) / @p.TotalCount</div>

        @if (p.TotalPages > 1)
        {
            <nav aria-label="Phân trang">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(p.PageIndex == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Href(Math.Max(1, p.PageIndex - 1))">&laquo;</a>
                    </li>
                    @foreach (var n in shown)
                    {
                        if (prev != 0 && n - prev > 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item @(n == p.PageIndex ? "active" : "")">
                            <a class="page-link" href="@Href(n)">@n</a>
                        </li>
                        prev = n;
                    }
                    <li class="page-item @(p.PageIndex == p.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Href(Math.Min(p.TotalPages, p.PageIndex + 1))">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}