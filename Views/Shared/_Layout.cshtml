@using Microsoft.EntityFrameworkCore
@inject WebVanChuyenLogicstic.Data.AppDbContext Db
@{
    var site = Db.SiteSettings.AsNoTracking().FirstOrDefault() ?? new SiteSetting();
    var routeKey = $"{ViewContext.RouteData.Values["controller"]}/{ViewContext.RouteData.Values["action"]}";
    var seo = Db.SeoPages.AsNoTracking().FirstOrDefault(p => p.Route == routeKey);
    var pageTitle = string.IsNullOrWhiteSpace(seo?.MetaTitle)
        ? $"{ViewData["Title"]} - {site.SiteName}"
        : seo!.MetaTitle;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(seo?.MetaDescription))
    {
        <meta name="description" content="@seo!.MetaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(seo?.Keywords))
    {
        <meta name="keywords" content="@seo!.Keywords" />
    }
    <link rel="icon" href="@(string.IsNullOrEmpty(site.FaviconUrl) ? "/favicon.ico" : site.FaviconUrl)" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var pendingQuotes = 0;
        var userRole = Context.Session.GetString("UserRole");
        if (Context.Session.GetInt32("UserId") is int currentUserId)
        {
            var now = DateTime.Now;
            pendingQuotes = Db.Orders.Count(o => o.CustomerId == currentUserId
            && o.Status == OrderStatuses.Quoted
            && (o.QuoteValidUntil == null || o.QuoteValidUntil >= now));
        }
    }
    <header class="site-header">
        <div class="topbar"><div class="container d-flex justify-content-between"><span><i class="bi bi-telephone"></i> Hotline: <b>@site.Hotline</b></span><span class="d-none d-md-inline"><i class="bi bi-envelope"></i> @site.Email</span></div></div>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(site.LogoUrl))
                    {
                        <img src="@site.LogoUrl" alt="@site.SiteName" style="height:44px;max-width:180px;object-fit:contain" />
                    }
                    else
                    {
                        <span class="brand-mark"><i class="bi bi-truck"></i></span>
                    
                        <span>LMS <b>EXPRESS</b><small>LOGISTICS</small></span>
                    }
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Service" asp-action="Index">Dịch vụ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Project" asp-action="Index">Dự án</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Process" asp-action="Index">Quy trình</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold text-primary" asp-controller="News" asp-action="Index">Tin tức</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Policy">Chính sách</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                    <a class="btn btn-accent btn-sm me-2" asp-controller="Service" asp-action="Quote">Tạo đơn</a>
                    <div class="nav-account">
                        <div class="dropdown">
                            <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="position:relative">
                                <i class="bi bi-person-circle"></i>
                                @if (pendingQuotes > 0)
                                {
                                    <span class="badge rounded-pill bg-danger" style="position:absolute;top:-4px;right:-6px;font-size:.6rem">@pendingQuotes</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu">
                                @if (Context.Session.GetString("UserName") is string userName)
                                {
                                    <li class="user-dropdown-greeting"><i class="bi bi-person-check me-2"></i>@userName</li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Hồ sơ của tôi</a></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="MyOrder" asp-action="Index">
                                            <i class="bi bi-box-seam me-2"></i>Đơn của tôi
                                            @if (pendingQuotes > 0)
                                            {
                                                <span class="badge rounded-pill bg-danger ms-1">@pendingQuotes</span>
                                            }
                                        </a>
                                    </li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
                                    @if (userRole == "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Home"><i class="bi bi-speedometer2 me-2"></i>Trang quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="px-3 pb-2">
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-brand w-100" type="submit">Đăng xuất</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li class="px-3 pt-2"><a class="btn btn-sm btn-outline-brand w-100 mb-2" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                                    <li class="px-3 pb-2"><a class="btn btn-sm btn-primary-brand w-100" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    @if (TempData["NewsletterSuccess"] is string nlOk)
    {
        <div class="container mt-3"><div class="alert alert-success mb-0">@nlOk</div></div>
    }
    @if (TempData["NewsletterError"] is string nlErr)
    {
        <div class="container mt-3"><div class="alert alert-danger mb-0">@nlErr</div></div>
    }
    <main>@RenderBody()</main>
    <footer class="custom-footer">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-lg-4">
                    <a class="navbar-brand footer-brand" asp-controller="Home" asp-action="Index">
                        @if (!string.IsNullOrEmpty(site.LogoUrl))
                        {
                            <img src="@site.LogoUrl" alt="@site.SiteName" style="height:44px;max-width:180px;object-fit:contain" />
                        }
                        else
                        {
                            <span class="brand-mark"><i class="bi bi-truck"></i></span>
                            <span>LMS <b>EXPRESS</b><small>LOGISTICS</small></span>
                        }
                    </a>
                    <p class="mt-3">@site.FooterIntro</p>
                    <div class="footer-social">
                        @if (!string.IsNullOrEmpty(site.FacebookUrl))
                        {
                            <a href="@site.FacebookUrl" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.YoutubeUrl))
                        {
                            <a href="@site.YoutubeUrl" target="_blank" rel="noopener"><i class="bi bi-youtube"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.LinkedInUrl))
                        {
                            <a href="@site.LinkedInUrl" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.TikTokUrl))
                        {
                            <a href="@site.TikTokUrl" target="_blank" rel="noopener"><i class="bi bi-tiktok"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.ZaloUrl))
                        {
                            <a href="@site.ZaloUrl" target="_blank" rel="noopener" title="Zalo"><b style="font-size:.8rem">Zalo</b></a>
                        }
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h5>Khám phá</h5>
                    <a asp-controller="Home" asp-action="About">Giới thiệu</a>
                    <a asp-controller="Service" asp-action="Index">Dịch vụ</a>
                    <a asp-controller="Project" asp-action="Index">Dự án</a>
                    <a asp-controller="Process" asp-action="Index">Quy trình</a>
                    <a asp-controller="News" asp-action="Index">Tin tức</a>
                   
                </div>

                <div class="col-6 col-lg-2">
                    <h5>Hỗ trợ</h5>
                    <a asp-controller="Home" asp-action="Policy">Chính sách</a>
                    <a asp-controller="Home" asp-action="Terms">Điều khoản</a>
                    <a asp-controller="Home" asp-action="Faq">Câu hỏi thường gặp</a>
                    @foreach (var sp in Db.StaticPages.AsNoTracking().Where(p => p.IsPublished && !p.IsSystem).OrderBy(p => p.Title).ToList())
                    {
                        <a asp-controller="Home" asp-action="Page" asp-route-slug="@sp.Slug">@sp.Title</a>
                    }
                    <a asp-controller="Home" asp-action="Contact">Liên hệ</a>
                </div>

                <div class="col-lg-4">
                    <h5>Liên hệ</h5>
                    <p><i class="bi bi-geo-alt"></i> @site.Address</p>
                    <p><i class="bi bi-telephone"></i> Hotline 24/7: @site.Hotline</p>
                    <p><i class="bi bi-envelope"></i> @site.Email</p>
                    @if (!string.IsNullOrEmpty(site.WorkingHours))
                    {
                        <p><i class="bi bi-clock"></i> @site.WorkingHours</p>
                    }

                    <h5 class="mt-4">Đăng ký nhận tin</h5>
                    <form asp-controller="Home" asp-action="SubscribeNews" method="post" class="footer-subscribe">
                        @Html.AntiForgeryToken()
                        <input type="email" name="SubscribeEmail" placeholder="Email của bạn" required />
                        <button type="submit"><i class="bi bi-send"></i></button>
                    </form>
                </div>
            </div>
            <div class="footer-bottom">@(site.Copyright ?? $"© {DateTime.Now.Year} {site.SiteName}")</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
