@using WebVanChuyenLogicstic.Models
@model WebVanChuyenLogicstic.Models.Article
@{
    ViewData["Title"] = Model.Title;
}

<article class="pb-5">
    <!-- Tiêu đề & Thông tin cơ bản -->
    <header class="bg-light py-5 border-bottom">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <span class="badge bg-primary px-3 py-2 mb-3 fw-medium">@Model.Category</span>
                    <h1 class="fw-bold text-dark mb-4" style="line-height: 1.3;">@Model.Title</h1>
                    <div class="d-flex justify-content-center align-items-center text-muted">
                        <span class="me-4"><i class="bi bi-calendar3 me-1"></i> Ngày đăng: @Model.PublishedAt.ToString("dd/MM/yyyy")</span>
                        <span><i class="bi bi-person-circle me-1"></i> Tác giả: Admin</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Nội dung chính -->
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                
                <!-- Đoạn tóm tắt (Lead paragraph) -->
                <p class="lead fw-medium text-dark mb-5 border-start border-4 border-primary ps-4 py-2 bg-light">
                    @Model.Summary
                </p>

                <!-- Lặp qua các mục nội dung (ArticleSections) -->
                <div class="article-content" style="line-height: 1.8; font-size: 1.05rem;">
                    @if (Model.Blocks != null && Model.Blocks.Any())
                    {
                        foreach (var item in Model.Blocks)
                        {
                            <div class="mb-5">
                                <h4 class="fw-bold text-primary mb-3">
                                    <i class="bi @Model.Icon me-2 text-muted" style="font-size: 1.2rem;"></i>@item.Heading
                                </h4>
                                <p class="text-secondary text-justify" style="white-space:pre-line">@item.Body</p>
                            </div>
                        }
                    }
                </div>

                <hr class="my-5" />

                <!-- Nút điều hướng -->
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="News" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại Danh sách
                    </a>
                    
                    <!-- Các nút chia sẻ (Tùy chọn) -->
                    <div class="d-flex gap-2">
                        <button class="btn btn-light text-primary border"><i class="bi bi-facebook"></i></button>
                        <button class="btn btn-light text-info border"><i class="bi bi-twitter"></i></button>
                        <button class="btn btn-light text-secondary border"><i class="bi bi-link-45deg"></i> Sao chép link</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</article>