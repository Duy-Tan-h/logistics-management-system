@model List<WebVanChuyenLogicstic.Models.Trip>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chuyến vận chuyển";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Chuyến vận chuyển</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Tạo chuyến</a>
</div>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Tất cả</a>
    @foreach (var s in TripStatuses.All)
    {
        <a asp-action="Index" asp-route-status="@s" class="btn btn-sm @(ViewBag.Status == s ? "btn-primary" : "btn-outline-secondary")">@s</a>
    }
</div>

<div class="card border-0 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Tuyến đường</th><th>Xe</th><th>Tài xế</th><th class="text-end">Số đơn</th><th class="text-end">Tổng kg</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="fw-semibold">@t.Route</td>
                    <td>@t.Vehicle?.PlateNumber</td>
                    <td>@t.Driver?.FullName</td>
                    <td class="text-end">@t.Orders.Count</td>
                    <td class="text-end">@t.Orders.Sum(l => l.Order?.WeightKg ?? 0).ToString("n1")</td>
                    <td><span class="badge bg-secondary-subtle text-dark border">@t.Status</span></td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Chưa có chuyến nào.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />