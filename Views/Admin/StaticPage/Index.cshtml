@model List<WebVanChuyenLogicstic.Models.StaticPage>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Trang tĩnh";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Quản lý trang tĩnh</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm trang</a>
</div>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card border-0 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Tiêu đề</th><th>Đường dẫn</th><th>Loại</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr class="@(p.IsPublished ? "" : "text-muted")">
                    <td class="fw-semibold">@p.Title</td>
                    <td class="small">@(p.IsSystem? p.Slug: "/trang/" + p.Slug)</td>
                    <td>@if (p.IsSystem) {
                    <span class="badge bg-info-subtle text-info border border-info">Hệ thống</span>
                } else
                {

                    <span class="text-muted small">Tự tạo</span>
                }
</td>
                <td>@if (p.IsPublished) {
                <span class="badge bg-success-subtle text-success border border-success">Đang hiện</span>
                                } else
                {

                    <span class="badge bg-secondary-subtle text-secondary border border-secondary">Đã ẩn</span>
                }
</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa trang này?');">
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />