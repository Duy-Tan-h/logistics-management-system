@model List<WebVanChuyenLogicstic.Models.CargoType>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Loại hàng hóa";
    var counts = ViewBag.OrderCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Quản lý loại hàng hóa</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm loại hàng</a>
</div>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<p class="text-muted small">Danh sách này được gợi ý trong ô "Loại hàng hóa" của form báo giá. Khối lượng, số kiện và ghi chú của từng lô hàng nằm trong chi tiết đơn.</p>

<div class="card border-0 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Loại hàng</th><th>Mô tả</th><th>Đặc biệt</th><th>Trạng thái</th><th class="text-center">Số đơn</th><th class="text-end">Thao tác</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr class="@(c.IsActive ? "" : "text-muted")">
                    <td class="fw-semibold">@c.Name</td>
                    <td class="small">@(c.Description ?? "—")</td>
                    <td>
                        @if (c.IsSpecial)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger">Hàng đặc biệt</span>
                        }
                        else
                        {

                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success">Đang dùng</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary-subtle text-secondary border border-secondary">Tạm ngưng</span>
                        }
                    </td>
                    <td class="text-center">@(counts.TryGetValue(c.Name, out var n) ? n : 0)</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa loại hàng này?');">
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Chưa có loại hàng nào.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />