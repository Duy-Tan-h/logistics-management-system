@model WebVanChuyenLogicstic.Models.CargoType
@{
    var isNew = Model.Id == 0;
}

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm p-4" style="max-width:650px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-semibold">Tên loại hàng <span class="text-danger">*</span></label>
        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Hàng dễ vỡ" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
        <textarea asp-for="Description" rows="2" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <div class="form-check form-switch mb-2">
            <input asp-for="IsSpecial" class="form-check-input" />
            <label asp-for="IsSpecial" class="form-check-label fw-semibold">Hàng đặc biệt (dễ vỡ, cần bảo quản riêng)</label>
        </div>
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label fw-semibold">Đang sử dụng (gợi ý trong form báo giá)</label>
        </div>
    </div>

    <div class="text-end">
        <a asp-action="Index" class="btn btn-light border me-2">Hủy</a>
        <button type="submit" class="btn btn-primary px-4">@(isNew ? "Thêm loại hàng" : "Lưu thay đổi")</button>
    </div>
</form>