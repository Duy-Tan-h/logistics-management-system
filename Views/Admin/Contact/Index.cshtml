@using WebVanChuyenLogicstic.Models
@model List<ContactMessage>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản lý Liên hệ & Nhận tin";
    var subscribers = ViewBag.Subscribers as List<NewsletterSubscriber> ?? new List<NewsletterSubscriber>();
    var totalContacts = Model is IPagedList mp ? mp.TotalCount : Model.Count;
    var totalSubs = subscribers is IPagedList sp ? sp.TotalCount : subscribers.Count;
}

<style>
    .admin-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #f3f4f6;
    }

    .nav-tabs .nav-link {
        color: #4b5563;
        font-weight: 600;
        border: none;
        padding: 0.75rem 1.25rem;
    }

        .nav-tabs .nav-link.active {
            color: #0d6efd;
            border-bottom: 3px solid #0d6efd;
            background: transparent;
        }

    .table > :not(caption) > * > * {
        padding: 0.85rem 1rem;
        vertical-align: middle;
    }
</style>

<!-- TIÊU ĐỀ TRANG -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Quản lý Liên hệ & Nhận tin</h4>
        <small class="text-muted">Theo dõi phản hồi từ khách hàng và danh sách email bản tin</small>
    </div>
</div>

<!-- THÔNG BÁO -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KHU VỰC TABS CHUYỂN ĐỔI -->
<div class="admin-card p-4 mb-4">
    <ul class="nav nav-tabs mb-4" id="contactTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="contacts-tab" data-bs-toggle="tab" data-bs-target="#contacts-pane" type="button" role="tab">
                <i class="bi bi-chat-left-text me-2"></i>Tin nhắn liên hệ
                <span class="badge bg-primary rounded-pill ms-1">@totalContacts</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="subscribers-tab" data-bs-toggle="tab" data-bs-target="#subscribers-pane" type="button" role="tab">
                <i class="bi bi-envelope-check me-2"></i>Email Đăng ký nhận tin
                <span class="badge bg-secondary rounded-pill ms-1">@totalSubs</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="contactTabsContent">

        <!-- TAB 1: DANH SÁCH TIN NHẮN LIÊN HỆ -->
        <div class="tab-pane fade show active" id="contacts-pane" role="tabpanel">
            @if (Model.Any())
            {
                <div class="mb-3">
                    <select id="replyFilter" class="form-select" style="max-width:220px">
                        <option value="">Tất cả liên hệ</option>
                        <option value="no">Chưa phản hồi</option>
                        <option value="yes">Đã phản hồi</option>
                    </select>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#ID</th>
                                <th>Khách hàng</th>
                                <th>Liên hệ</th>
                                <th>Nội dung yêu cầu</th>
                                <th>Trạng thái</th>
                                <th>Thời gian</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr data-replied="@(item.IsRead ? "yes" : "no")">
                                    <td class="fw-bold">#@item.Id</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.FullName</div>
                                    </td>
                                    <td>
                                        <div class="small"><i class="bi bi-telephone me-1 text-muted"></i>@item.PhoneNumber</div>
                                        <div class="small"><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</div>
                                    </td>
                                    <td>
                                        <p class="text-muted mb-0 text-truncate" style="max-width: 280px;" title="@item.Message">
                                            @item.Message
                                        </p>
                                    </td>
                                    <td>@if (item.IsRead) {
                                    <span class="badge bg-success-subtle text-success border border-success">Đã phản hồi</span>
                                } else
                                {

                                    <span class="badge bg-warning-subtle text-warning border border-warning">Chưa phản hồi</span>
                                }
    </td>
                                    <td class="small text-muted">
                                        @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="text-end">
                                        <!-- Nút xem chi tiết -->
                                        <button type="button" class="btn btn-sm btn-outline-info me-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detailModal-@item.Id">
                                            <i class="bi bi-eye"></i> Xem
                                        </button>

                                        <!-- Nút Xóa -->
                                        <form asp-controller="Contact" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tin nhắn này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="Model" />
                @foreach (var item in Model)
                {
                    <!-- MODAL XEM CHI TIẾT TIN NHẮN -->
                    <div class="modal fade" id="detailModal-@item.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold">Chi tiết liên hệ #@item.Id</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small mb-1">Họ tên khách hàng</label>
                                        <div class="fw-bold fs-6">@item.FullName</div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label text-muted small mb-1">Số điện thoại</label>
                                            <div><a href="tel:@item.PhoneNumber" class="text-decoration-none fw-semibold">@item.PhoneNumber</a></div>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label text-muted small mb-1">Email</label>
                                            <div><a href="mailto:@item.Email" class="text-decoration-none fw-semibold">@item.Email</a></div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small mb-1">Thời gian gửi</label>
                                        <div class="small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label text-muted small mb-1">Nội dung yêu cầu</label>
                                        <div class="p-3 bg-light rounded text-dark">@item.Message</div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <a href="mailto:@item.Email" class="btn btn-primary btn-sm">
                                        <i class="bi bi-reply me-1"></i> Phản hồi qua Email
                                    </a>
                                    <form asp-controller="Contact" asp-action="ToggleReplied" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-success btn-sm">@(item.IsRead ? "Bỏ đánh dấu phản hồi" : "Đánh dấu đã phản hồi")</button>
                                    </form>
                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                    <p class="text-muted">Chưa có tin nhắn liên hệ nào từ khách hàng.</p>
                </div>
            }
        </div>

        <!-- TAB 2: DANH SÁCH EMAIL ĐĂNG KÝ NHẬN TIN -->
        <div class="tab-pane fade" id="subscribers-pane" role="tabpanel">
            @if (subscribers.Any())
            {
                <input id="subSearch" class="form-control mb-3" style="max-width:320px" placeholder="Tìm email..." />
                <div class="table-responsive" style="max-width: 700px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">STT</th>
                                <th>Địa chỉ Email</th>
                                <th>Ngày đăng ký</th>
                                <th class="text-end" style="width: 120px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var stt = (subscribers is IPagedList ps ? (ps.PageIndex - 1) * ps.PageSize : 0) + 1;
                            }
                            @foreach (var sub in subscribers)
                            {
                                <tr data-email="@sub.Email.ToLowerInvariant()">
                                    <td>@stt</td>
                                    <td class="fw-semibold text-dark">@sub.Email</td>
                                    <td class="small text-muted">@sub.SubscribedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <form asp-controller="Contact" asp-action="DeleteSubscriber" method="post" class="d-inline" onsubmit="return confirm('Xóa email này khỏi danh sách?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="email" value="@sub.Email" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                                        </form>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="subscribers" />
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-envelope-paper fs-1 text-muted d-block mb-2"></i>
                    <p class="text-muted">Chưa có ai đăng ký nhận bản tin.</p>
                </div>
            }
        </div>

    </div>
</div>
<script>
    // Chuyển trang ở tab Email đăng ký thì mở lại đúng tab đó
        document.addEventListener('DOMContentLoaded', function () {
            if (location.hash === '#subscribers-pane') {
                var t = document.getElementById('subscribers-tab');
                if (t) bootstrap.Tab.getOrCreateInstance(t).show();
            }
        });
    document.getElementById('replyFilter')?.addEventListener('change', function () {
        document.querySelectorAll('#contacts-pane tbody tr[data-replied]').forEach(function (tr) {
            tr.style.display = !this.value || tr.dataset.replied === this.value ? '' : 'none';
        }, this);
    });
    document.getElementById('subSearch')?.addEventListener('input', function () {
        var k = this.value.trim().toLowerCase();
        document.querySelectorAll('#subscribers-pane tbody tr[data-email]').forEach(function (tr) {
            tr.style.display = tr.dataset.email.includes(k) ? '' : 'none';
        });
    });
</script>