@using WebVanChuyenLogicstic.Models
@model IEnumerable<WebVanChuyenLogicstic.Models.Article>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản lý Bài viết";
}

<!-- CSS Cục bộ cho trang Index Bài viết -->
<style>
    .admin-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #f3f4f6;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background-color: #f8f9fa;
        color: #0d6efd;
        font-size: 1.5rem;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }
</style>

<!-- Thanh công cụ: Tiêu đề & Nút Thêm mới -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Danh sách bài viết</h4>
        <p class="text-muted small mb-0">Quản lý tin tức, khuyến mãi và hướng dẫn hệ thống</p>
    </div>
    <a href="/Admin/Article/Create" class="btn btn-primary fw-medium px-4">
        <i class="bi bi-plus-lg me-1"></i> Viết bài mới
    </a>
</div>

<!-- Khung bao ngoài danh sách -->
<div class="admin-card p-4">
    <!-- Bộ lọc & Tìm kiếm -->
    @{
        var cat = ViewBag.Category as string;
        var st = ViewBag.Status as string;
    }
    <form method="get" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm kiếm theo tiêu đề bài viết...">
            </div>
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select">
                <option value="">Tất cả chuyên mục</option>
                @foreach (var c in ArticleCategories.All)
                {
                    <option value="@c" selected="@(cat == c)">@c</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">Trạng thái</option>
                <option value="published" selected="@(st == "published")">Đã xuất bản</option>
                <option value="draft" selected="@(st == "draft")">Bản nháp</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button class="btn btn-primary flex-fill"><i class="bi bi-funnel"></i> Lọc</button>
            <a asp-action="Index" class="btn btn-light border" title="Xóa lọc"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>

    <!-- Bảng dữ liệu -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 5%">ID</th>
                    <th scope="col" style="width: 10%">Biểu tượng</th>
                    <th scope="col" style="width: 40%">Tiêu đề</th>
                    <th scope="col" style="width: 15%">Chuyên mục</th>
                    <th scope="col" style="width: 10%">Ngày đăng</th>
                    <th scope="col" class="text-end" style="width: 15%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var article in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-muted">#@article.Id</td>

                            <!-- Dùng Icon của Model thay vì Hình ảnh -->
                            <td>
                                <div class="icon-box border">
                                    <i class="bi @article.Icon"></i>
                                </div>
                            </td>

                            <td>
                                <a href="/Admin/Article/Edit/@article.Id" class="text-dark text-decoration-none fw-semibold d-block text-truncate" style="max-width: 350px;" title="@article.Title">
                                    @article.Title
                                </a>
                                <small class="text-muted text-truncate d-block" style="max-width: 350px;">@article.Summary</small>
                            </td>

                            <td>
                                <!-- Bạn có thể dùng Switch Case để đổi màu Badge tùy theo Category, ở đây dùng mặc định màu Primary -->
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">
                                    @article.Category
                                </span>
                            </td>

                            <td class="text-muted small">
                                @article.PublishedAt.ToString("dd/MM/yyyy")<br />
                                @if (article.IsPublished)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Đã xuất bản</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary">Bản nháp</span>
                                }
                            </td>

                            <td class="text-end">
                                <a href="/News/Details/@article.Id" target="_blank" class="btn btn-sm btn-outline-info action-btn me-1" title="Xem thử ngoài trang chủ">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="/Admin/Article/Edit/@article.Id" class="btn btn-sm btn-outline-primary action-btn me-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Article" asp-action="Delete" asp-route-id="@article.Id" method="post"
                                      class="d-inline" onsubmit="return confirm('Xóa bài viết này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger action-btn" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Chưa có bài viết nào trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <partial name="_Pager" model="Model" />
</div>