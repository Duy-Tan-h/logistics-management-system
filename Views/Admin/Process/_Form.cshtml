@model WebVanChuyenLogicstic.Models.ProcessStep
@{
    var isNew = Model.Id == 0;
}

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm p-4" style="max-width:640px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="Number" class="form-label fw-semibold">Thứ tự <span class="text-danger">*</span></label>
            <input asp-for="Number" type="number" min="1" max="50" class="form-control" />
            <span asp-validation-for="Number" class="text-danger small"></span>
        </div>
        <div class="col-md-9">
            <label asp-for="Icon" class="form-label fw-semibold">Biểu tượng <span class="text-danger">*</span></label>
            <input asp-for="Icon" class="form-control" list="step-icons" placeholder="bi-box-seam" />
            <datalist id="step-icons">
                <option value="bi-clipboard-check"></option>
                <option value="bi-telephone"></option>
                <option value="bi-box-seam"></option>
                <option value="bi-truck"></option>
                <option value="bi-geo-alt"></option>
                <option value="bi-check2-circle"></option>
            </datalist>
            <span asp-validation-for="Icon" class="text-danger small"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label fw-semibold">Tên bước <span class="text-danger">*</span></label>
        <input asp-for="Title" class="form-control" placeholder="Tiếp nhận yêu cầu" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Description" class="form-label fw-semibold">Mô tả <span class="text-danger">*</span></label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="text-end">
        <a asp-action="Index" class="btn btn-light border me-2">Hủy</a>
        <button class="btn btn-primary px-4">@(isNew ? "Thêm bước" : "Lưu thay đổi")</button>
    </div>
</form>