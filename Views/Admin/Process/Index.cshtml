@model List<WebVanChuyenLogicstic.Models.ProcessStep>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quy trình vận chuyển";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">Quy trình vận chuyển</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm bước</a>
</div>
<p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>Các bước hiện ở trang /Process và khối "Quy trình" trên trang chủ (nên giữ 4–6 bước). Đổi số thứ tự để chèn bước, hệ thống tự đánh lại số.</p>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<div class="card border-0 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th style="width:70px">Bước</th><th>Nội dung</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td><span class="badge bg-primary rounded-pill fs-6">@s.Number</span></td>
                    <td>
                        <div class="fw-semibold"><i class="bi @s.Icon text-primary me-2"></i>@s.Title</div>
                        <div class="small text-muted">@s.Description</div>
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa bước này?');">
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="3" class="text-center text-muted py-4">Chưa có bước nào.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />