@model List<WebVanChuyenLogicstic.Models.SeoPage>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "SEO";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">Quản lý SEO từng trang</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm cấu hình</a>
</div>
<p class="text-muted small">Để trống Meta Title thì website tự dùng tiêu đề mặc định của trang.</p>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<div class="card border-0 shadow-sm p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Trang</th><th>Meta Title</th><th>Meta Description</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><div class="fw-semibold">@p.PageName</div><div class="small text-muted">/@p.Route</div></td>
                        <td class="small">@(p.MetaTitle ?? "—")</td>
                        <td class="small" style="max-width:340px">@(p.MetaDescription ?? "—")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa cấu hình SEO này?');">
                                <button class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model" />