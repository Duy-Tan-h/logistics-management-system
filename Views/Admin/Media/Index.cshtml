@model List<WebVanChuyenLogicstic.Models.MediaItem>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var type = ViewBag.Type as string ?? MediaTypes.Partner;
    var isBanner = type == MediaTypes.Banner;
    var noun = isBanner ? "banner" : "đối tác";
    ViewData["Title"] = MediaTypes.Label(type);
}

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(!isBanner ? "active" : "")" href="/Admin/Media?type=Partner">Đối tác</a></li>
    <li class="nav-item"><a class="nav-link @(isBanner ? "active" : "")" href="/Admin/Media?type=Banner">Banner quảng cáo</a></li>
    <li class="nav-item"><a class="nav-link" href="/Admin/Media/Library">Thư viện ảnh</a></li>
</ul>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="fw-bold mb-0">@MediaTypes.Label(type)</h4>
    <a asp-action="Create" asp-route-type="@type" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm @noun</a>
</div>
<p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>Hiện ở khối "@(isBanner ? "Banner quảng cáo" : "Đối tác đồng hành")" trên trang chủ. Đổi vị trí hoặc ẩn cả khối tại <a href="/Admin/HomeContent/Index">Quản lý trang chủ</a>.</p>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<div class="card border-0 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th style="width:140px">Ảnh</th><th>Tiêu đề</th><th>Thứ tự</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr class="@(m.IsVisible ? "" : "text-muted")">
                    <td><img src="@m.ImageUrl" alt="" style="width:120px;height:56px;object-fit:contain;background:#f5f7fa;border-radius:6px" /></td>
                    <td><div class="fw-semibold">@m.Title</div>@if (!string.IsNullOrEmpty(m.LinkUrl)) {
                    <div class="small text-muted">@m.LinkUrl</div>
                }</td>
           
                <td>@m.DisplayOrder</td>
                <td>@if (m.IsVisible) {
                <span class="badge bg-success-subtle text-success border border-success">Đang hiện</span>
                                } else
                {

                    <span class="badge bg-secondary-subtle text-secondary border border-secondary">Đã ẩn</span>
                }
</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa @noun này?');">
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
                        }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Chưa có @noun nào.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />