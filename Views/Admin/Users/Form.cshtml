@model WebVanChuyenLogicstic.Models.Admin.AdminUserFormViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = Model.Id == 0 ? "Thêm tài khoản quản trị" : "Sửa tài khoản quản trị";
    var roles = (List<Role>)ViewBag.Roles;
}

<h4 class="fw-bold mb-4">@ViewData["Title"]</h4>

<form method="post" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" class="card border-0 shadow-sm p-4" style="max-width:640px">
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <label class="form-label fw-semibold">Họ tên</label>
    <input asp-for="FullName" class="form-control mb-3" />

    <label class="form-label fw-semibold">Email đăng nhập</label>
    <input asp-for="Email" class="form-control mb-3" />

    <label class="form-label fw-semibold">@(Model.Id == 0 ? "Mật khẩu ban đầu" : "Mật khẩu mới (để trống nếu không đổi)")</label>
    <input asp-for="Password" type="password" autocomplete="new-password" class="form-control mb-3" />

    <label class="form-label fw-semibold">Vai trò</label>
    <select asp-for="RoleId" class="form-select mb-1">
        <option value="">-- Chọn vai trò --</option>
        @foreach (var r in roles)
        {
            <option value="@r.Id" selected="@(r.Id == Model.RoleId)">@r.Name</option>
        }
    </select>
    <div class="small text-muted mb-3">
        @foreach (var r in roles)
        {
            <div><strong>@r.Name:</strong> @r.Description</div>
        }
    </div>

    <div class="form-check mb-4">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Tài khoản đang hoạt động</label>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-light border">Quay lại</a>
    </div>
</form>