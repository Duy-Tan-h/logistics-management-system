@model List<WebVanChuyenLogicstic.Models.AdminUser>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Tài khoản quản trị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Tài khoản quản trị</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm tài khoản</a>
</div>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card border-0 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="fw-semibold">@a.FullName</td>
                    <td>@a.Email</td>
                    <td><span class="badge bg-primary-subtle text-primary border border-primary">@a.Role?.Name</span></td>
                    <td>
                        @if (a.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success">Hoạt động</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary-subtle text-secondary border">Đã khóa</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="ToggleActive" asp-route-id="@a.Id" method="post" class="d-inline"
                              onsubmit="return confirm('@(a.IsActive ? "Khóa" : "Mở khóa") tài khoản này?');">
                            <button class="btn btn-sm @(a.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(a.IsActive ? "Khóa" : "Mở khóa")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />