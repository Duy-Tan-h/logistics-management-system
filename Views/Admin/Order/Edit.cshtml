@model WebVanChuyenLogicstic.Models.Admin.OrderEditViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Sửa đơn " + Model.OrderCode;
}
<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border"><i class="bi bi-arrow-left"></i></a>
    <h4 class="fw-bold mb-0">Sửa thông tin đơn @Model.OrderCode</h4>
</div>
@if (Model.Status == OrderStatuses.Quoted)
{
    <div class="alert alert-warning small">Đơn đã báo giá. Nếu sửa loại hàng, khối lượng hoặc địa chỉ, hãy báo giá lại cho khách.</div>
}
<form asp-action="EditInfo" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm p-4" style="max-width:820px">
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="CustomerName" class="form-label fw-semibold">Khách hàng</label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label fw-semibold">Điện thoại</label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
        <div class="col-md-12"><label asp-for="Email" class="form-label fw-semibold">Email</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="ReceiverName" class="form-label fw-semibold">Người nhận</label><input asp-for="ReceiverName" class="form-control" /><span asp-validation-for="ReceiverName" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="ReceiverPhone" class="form-label fw-semibold">Điện thoại người nhận</label><input asp-for="ReceiverPhone" class="form-control" /><span asp-validation-for="ReceiverPhone" class="text-danger small"></span></div>
        <div class="col-md-12"><label asp-for="PickupAddress" class="form-label fw-semibold">Địa chỉ lấy hàng</label><input asp-for="PickupAddress" class="form-control" /><span asp-validation-for="PickupAddress" class="text-danger small"></span></div>
        <div class="col-md-12"><label asp-for="DeliveryAddress" class="form-label fw-semibold">Địa chỉ giao hàng</label><input asp-for="DeliveryAddress" class="form-control" /><span asp-validation-for="DeliveryAddress" class="text-danger small"></span></div>
        <div class="col-12">
            <label class="form-label fw-semibold">Hàng hóa</label>
            <partial name="_ItemsEditor" model="Model.Items" />
        </div>
        <div class="col-md-6"><label asp-for="ExpectedShipDate" class="form-label fw-semibold">Ngày dự kiến gửi</label><input asp-for="ExpectedShipDate" type="date" class="form-control" /></div>
        <div class="col-md-12"><label asp-for="Note" class="form-label fw-semibold">Ghi chú</label><textarea asp-for="Note" rows="3" class="form-control"></textarea><span asp-validation-for="Note" class="text-danger small"></span></div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border">Hủy</a>
    </div>
</form>