@model WebVanChuyenLogicstic.Models.Vehicle
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Sửa phương tiện";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left"></i></a>
    <h4 class="fw-bold mb-0">Sửa phương tiện</h4>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm p-4" style="max-width:650px">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="PlateNumber" class="form-label fw-semibold">Biển số <span class="text-danger">*</span></label>
        <input asp-for="PlateNumber" class="form-control" placeholder="51C-123.45" />
        <span asp-validation-for="PlateNumber" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VehicleType" class="form-label fw-semibold">Loại xe <span class="text-danger">*</span></label>
        <select asp-for="VehicleType" class="form-select">
            <option value="">-- Chọn --</option>
            <option>Xe máy</option>
            <option>Xe tải nhỏ</option>
            <option>Xe tải trung</option>
            <option>Xe tải lớn</option>
            <option>Container</option>
        </select>
        <span asp-validation-for="VehicleType" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CapacityKg" class="form-label fw-semibold">Tải trọng (kg)</label>
        <input asp-for="CapacityKg" type="number" step="1" class="form-control" />
        <span asp-validation-for="CapacityKg" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label fw-semibold">Trạng thái</label>
        <select asp-for="Status" class="form-select">
            <option>Đang hoạt động</option>
            <option>Bảo trì</option>
            <option>Ngừng sử dụng</option>
        </select>
    </div>

    <div class="mb-4">
        <label asp-for="Note" class="form-label fw-semibold">Ghi chú</label>
        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
    </div>
</form>