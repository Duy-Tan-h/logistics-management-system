@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-side">
                <span class="eyebrow">BẢO MẬT TÀI KHOẢN</span>
                <h2>Đổi mật khẩu</h2>
                <p>Nên đổi ngay nếu bạn đang dùng mật khẩu tạm do nhân viên cấp.</p>
                <div class="auth-benefit"><i class="bi bi-shield-check"></i> Mật khẩu được mã hóa trước khi lưu</div>
            </div>
            <div class="auth-form">
                <h1>Đổi mật khẩu</h1>
                <p>Nhập mật khẩu hiện tại và mật khẩu mới</p>

                @if (TempData["Success"] is string message)
                {
                    <div class="alert alert-success">@message</div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewPassword">Mật khẩu mới</label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button class="btn btn-primary-brand w-100 py-3">Lưu mật khẩu mới</button>
                </form>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}