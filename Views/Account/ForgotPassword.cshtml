@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-side">
                <span class="eyebrow">HỖ TRỢ TÀI KHOẢN</span>
                <h2>Quên mật khẩu?</h2>
                <p>Gửi yêu cầu, nhân viên sẽ cấp mật khẩu tạm và gửi vào email đã đăng ký của bạn.</p>
                <div class="auth-benefit"><i class="bi bi-shield-check"></i> Mật khẩu chỉ được gửi về email của tài khoản</div>
            </div>
            <div class="auth-form">
                <a asp-action="Login" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a>
                <h1 class="mt-3">Quên mật khẩu</h1>

                @if (TempData["Success"] is string message)
                {
                    <div class="alert alert-success mt-3">@message</div>
                }
                else
                {
                    <p>Nhập email bạn đã dùng để đăng ký</p>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="form-group">
                            <label asp-for="Email">Email</label>
                            <div class="input-icon"><i class="bi bi-envelope"></i><input asp-for="Email" class="form-control" placeholder="name@email.com" /></div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <button class="btn btn-primary-brand w-100 py-3">Gửi yêu cầu</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}