@model LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-side"><span class="eyebrow">LMS EXPRESS</span><h2>Chào mừng bạn trở lại</h2><p>Đăng nhập để quản lý yêu cầu vận chuyển và theo dõi đơn hàng của bạn.</p><div class="auth-benefit"><i class="bi bi-shield-check"></i> Thông tin được bảo mật an toàn</div></div><div class="auth-form">
                <h1>Đăng nhập</h1><p>Nhập thông tin tài khoản của bạn</p>
                @if (TempData["Success"] is string message)
                {
                    <div class="alert alert-success">@message</div>
                }
                <form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="form-group"><label asp-for="Email">Email</label><div class="input-icon"><i class="bi bi-envelope"></i><input asp-for="Email" class="form-control" placeholder="name@email.com" /></div><span asp-validation-for="Email" class="text-danger"></span></div><div class="form-group"><label asp-for="Password">Mật khẩu</label><div class="input-icon"><i class="bi bi-lock"></i><input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" /></div><span asp-validation-for="Password" class="text-danger"></span></div><div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label></div><button class="btn btn-primary-brand w-100 py-3">Đăng nhập</button></form>

                @if (Env.IsDevelopment())
                {
                    <div class="alert alert-info small mt-3 mb-0" role="note">
                        <div class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i>Tài khoản quản trị</div>
                        <div>Email: <code>admin@lms.com</code> &nbsp;·&nbsp; Mật khẩu: <code>admin123</code></div>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                                onclick="document.getElementById('Email').value='admin@lms.com';document.getElementById('Password').value='admin123';">
                            Điền sẵn
                        </button>
                    </div>
                }

                <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p><p class="auth-switch"><a asp-action="ForgotPassword">Quên mật khẩu?</a></p>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}