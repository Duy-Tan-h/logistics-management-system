@model List<WebVanChuyenLogicstic.Models.Order>
@{
    ViewData["Title"] = "Đơn của tôi";
    var pending = Model.Count(o => o.IsQuoteOpen);
}

<partial name="_PageHero" model='new WebVanChuyenLogicstic.Models.PageHeroViewModel("Đơn của tôi", "Theo dõi đơn hàng và trả lời báo giá ngay tại đây.", "bi-box-seam")' />

<section class="section-space">
    <div class="container narrow-content">

        @if (pending > 0)
        {
            <div class="alert alert-warning">
                <i class="bi bi-bell me-1"></i> Bạn có <strong>@pending</strong> báo giá đang chờ trả lời.
            </div>
        }

        @if (!Model.Any())
        {
            <div class="content-card text-center">
                <h4>Bạn chưa có đơn hàng nào</h4>
                <p class="text-muted">Gửi yêu cầu báo giá để bắt đầu. Đơn gửi khi đã đăng nhập sẽ xuất hiện ở đây.</p>
                <a class="btn btn-accent" asp-controller="Service" asp-action="Quote">Yêu cầu báo giá</a>
            </div>
        }

        @foreach (var o in Model)
        {
            <div class="content-card mb-3 @(o.IsQuoteOpen ? "border border-2 border-warning" : "")">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <a asp-action="Details" asp-route-code="@o.OrderCode" class="fw-bold fs-5 text-decoration-none">@o.OrderCode</a>
                        <div class="text-muted small">@(o.Service?.Name ?? "Vận chuyển") · @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <span class="badge @OrderStatuses.Badge(o.Status)">@o.Status</span>
                </div>

                <div class="small mt-2">@o.PickupAddress → @o.DeliveryAddress</div>

                @if (o.IsQuoteOpen)
                {
                    <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="fw-bold fs-5">@OrderFormat.Money(o.QuotedPrice)</div>
                            <div class="small text-muted">Hiệu lực đến hết ngày @(o.QuoteValidUntil?.ToString("dd/MM/yyyy"))</div>
                        </div>
                        <a class="btn btn-accent" asp-action="Details" asp-route-code="@o.OrderCode">Xem và trả lời báo giá</a>
                    </div>
                }
                else if (o.Status == OrderStatuses.Quoted)
                {
                    <div class="mt-3 small text-warning">Báo giá đã hết hạn. Vui lòng liên hệ để nhận báo giá mới.</div>
                }
            </div>
        }
    </div>
</section>