@model List<WebVanChuyenLogicstic.Models.HomeSectionItem>
@{
    ViewData["Title"] = "Dự án tiêu biểu";
}

<partial name="_PageHero" model='new WebVanChuyenLogicstic.Models.PageHeroViewModel("Dự án tiêu biểu", "Những hành trình LMS Express đã đồng hành cùng khách hàng trên khắp cả nước.", "bi-kanban")' />

<section class="section-space">
    <div class="container">
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="project-grid-card">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" />
                        }
                        <div class="project-grid-body">
                            <h3>@item.Title</h3>
                            <p>@item.Description</p>
                            @if (!string.IsNullOrEmpty(item.LinkUrl))
                            {
                                <a href="@item.LinkUrl">Xem chi tiết <i class="bi bi-arrow-up-right"></i></a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</section>